# 复制为 .env.development（本地）或参考 .env.production（构建）
# 不要把含密钥的本地覆盖文件提交进仓库

# 是否使用 Hash 路由
VITE_USE_HASH=true

# 资源公共路径，需以 / 开头和结尾
VITE_PUBLIC_PATH=/

# Axios 基础路径（API 根，不含 /admin）
VITE_AXIOS_BASE_URL=http://127.0.0.1:8787

# 可选：开发代理目标
VITE_PROXY_TARGET=http://127.0.0.1:8787

# 安装到桌面时的名称。不填则用「管理后台」/「管理」
# VITE_PWA_NAME=
# VITE_PWA_SHORT_NAME=
# VITE_PWA_DESCRIPTION=
