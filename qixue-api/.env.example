# 复制为 qixue-api/.env 后填写。不要提交 .env。

APP_DEBUG=false
GO_API_ADDR=:8787

# 日志目录（相对 WorkingDirectory，线上即 /opt/qixue-api/logs）；按天切割，保留天数
LOG_DIR=logs
LOG_KEEP_DAYS=7

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DATABASE=0

# 两把密钥请分别用随机字符串生成，不要留空，也不要和示例相同
JWT_KEY=
JWT_WEAPP_KEY=
JWT_EXPIRE=18000

ASSET_DOMAIN=

# local 或 bunny。不写时按 bunny 处理
STORAGE_DRIVER=bunny

BUNNY_API_KEY=
BUNNY_STORAGE_ZONE=
BUNNY_REGION=sg
BUNNY_S3_ENDPOINT=
BUNNY_S3_ACCESS_KEY=
BUNNY_S3_SECRET_KEY=
BUNNY_ACCOUNT_API_KEY=

# 排行榜快照刷新秒数；0 关闭 ticker
RANK_SNAPSHOT_INTERVAL_SEC=180

OFFICIAL_COMMENT_USER_ID=0

# ---------- 本机发版静态站（服务器上的 .env 不用填）----------
# bunny：上传到各自的 Storage Zone。local：复制到本目录 public/admin 与 public/web。
STATIC_PUBLISH=bunny

BUNNY_ADMIN_STORAGE_ZONE=
BUNNY_ADMIN_STORAGE_PASSWORD=
BUNNY_ADMIN_REGION=
BUNNY_ADMIN_PULL_ZONE_ID=
BUNNY_ADMIN_PURGE_AFTER_PUBLISH=yes

BUNNY_H5_STORAGE_ZONE=
BUNNY_H5_STORAGE_PASSWORD=
BUNNY_H5_REGION=
BUNNY_H5_PULL_ZONE_IDS=
BUNNY_H5_PURGE_AFTER_PUBLISH=yes
BUNNY_H5_DIST=qixue-web/dist
